# Copy to .env.production and fill every value before deploying.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Domain & TLS (Caddy) ---
# Use your domain, or ":80" for HTTP-only testing on a VPS IP
DOMAIN=ingestx.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --- Postgres (internal — used to build DATABASE_URL) ---
POSTGRES_USER=ingestx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ingestx

# --- Connection strings (password must match POSTGRES_PASSWORD / REDIS_PASSWORD above) ---
DATABASE_URL=postgresql+psycopg2://ingestx:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ingestx
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# --- Redis (optional — leave empty to disable auth) ---
REDIS_PASSWORD=

# --- Application secrets (min 24 chars) ---
ENVIRONMENT=production
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET
WS_AUTH_TOKEN=CHANGE_ME_STREAM_AND_API_TOKEN

# --- CORS (must match your public URL) ---
CORS_ORIGINS=https://ingestx.yourdomain.com

# --- Scaling ---
API_WORKERS=2
OUTBOX_RETRY_INTERVAL=30
RQ_QUEUE_NAME=webhook_events
LOG_LEVEL=info

# --- Dashboard build ---
DEFAULT_MERCHANT_ID=merchant_demo
